# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# AI tooling — local dev aids, not site source (84MB+ of vendored
# binaries/scripts across 4 duplicate harness installs)
/.agent/
/.claude/
/.cursor/
/.gemini/
/.impeccable/

# raw project screenshots dropped here as a staging area; the real
# assets this site uses live in public/projects/
/projects/

# raw portrait source dropped at the root; the real copy the site
# uses lives at public/portrait.jpeg
/me.jpeg

# typescript
*.tsbuildinfo
next-env.d.ts
