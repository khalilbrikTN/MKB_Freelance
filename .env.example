# Copy this file to .env.local and fill in the real value (not committed).
# Also add RESEND_API_KEY to the project's Environment Variables in Vercel
# so the deployed site can send contact-form emails.

# Get a free API key at https://resend.com (no credit card required).
# Without verifying a custom domain, Resend only delivers to the email
# address on the Resend account itself — sign up with the same address
# as CONTACT_EMAIL in src/data/contact.ts.
RESEND_API_KEY=
